    42                                      ; 1. Encabezado con la macro print_str
    43                                      print_str titulo            ; expansion: mov ah,09h / mov dx,titulo / int 21h
    31 00000005 B409                <1>  mov ah, 09h
    32 00000007 BA[0000]            <1>  mov dx, %1
    33 0000000A CD21                <1>  int 21h
    44                                  
