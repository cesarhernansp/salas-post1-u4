    19 0000009F B20D                <1>  mov dl, 0Dh
    20 000000A1 CD21                <1>  int 21h
    21 000000A3 B20A                <1>  mov dl, 0Ah
    22 000000A5 CD21                <1>  int 21h
   111 000000A7 EB2A                        jmp .fin_comp
   112                                  
   113                                  .ax_mayor:
   114 000000A9 88C3                        mov bl, al                  ; BL = copia del valor de AX (AL cambia al imprimir)
   115                                      print_str msg_mayor
