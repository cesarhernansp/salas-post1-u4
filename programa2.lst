    78                                  
    79                                  ; --- Procedimientos ---------------------------------------------------------
    80                                  
    81                                  ; Procedimiento: suma acumulativa 1+2+3+...+N
    82                                  ; Entrada: CX = N (numero de iteraciones)
    83                                  ; Salida:  AX = suma total
    84                                  ; Preserva CX con PUSH/POP, porque LOOP lo decrementa hasta cero.
    85                                  sumar_serie:
    86 00000077 51                          push cx                     ; preservar CX (LOOP lo modifica)
    87 00000078 31C0                        xor ax, ax                  ; AX = 0 (acumulador)
    88                                  .paso:
    89 0000007A 01C8                        add ax, cx                  ; AX += CX (suma N, N-1, ..., 1)
    90 0000007C E2FC                        loop .paso                  ; CX--; si CX != 0, continuar
    91 0000007E 59                          pop cx                      ; restaurar el CX original
    92 0000007F C3                          ret
    93                                  
    94                                  ; Procedimiento: comparar AX y BX e imprimir el mayor (o un aviso de igualdad)
    95                                  ; Entrada: AX y BX con valores 0-9
    96                                  ; Preserva AX y BX con PUSH/POP. Decide con CMP, JE y JG.
    97                                  ; BL se usa como copia temporal del valor a imprimir, porque print_str altera
    98                                  ; AH y deja AL = "$" tras la funcion 09h.
    99                                  comparar_e_imprimir:
   100 00000080 50                          push ax
   101 00000081 53                          push bx
   102 00000082 39D8                        cmp ax, bx                  ; actualiza flags con AX - BX (sin modificar operandos)
   103 00000084 7446                        je .son_iguales             ; AX == BX (ZF = 1)
   104 00000086 7F21                        jg .ax_mayor                ; AX > BX con signo (ZF = 0 y SF = OF)
   105                                  
   106                                      ; Caso: BX es mayor
   107                                      print_str msg_mayor
    31 00000088 B409                <1>  mov ah, 09h
    32 0000008A BA[7300]            <1>  mov dx, %1
    33 0000008D CD21                <1>  int 21h
   108 0000008F 88D8                        mov al, bl                  ; AL = valor de BX
   109                                      print_digito
    74 00000091 50                  <1>  push ax
    75 00000092 240F                <1>  and al, 0Fh
    76 00000094 0430                <1>  add al, 30h
    77 00000096 B402                <1>  mov ah, 02h
    78 00000098 88C2                <1>  mov dl, al
    79 0000009A CD21                <1>  int 21h
    80 0000009C 58                  <1>  pop ax
   110                                      nueva_linea
