    49                                      ; La etiqueta se imprime antes de calcular: la funcion 09h deja AL = "$" y
    50                                      ; destruiria el resultado si se imprimiera despues de la suma.
    51                                      print_str msg_suma
    31 00000018 B409                <1>  mov ah, 09h
