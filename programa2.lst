   128                                  
   129                                  ; Procedimiento: comparar AX y BX e indicar si AX es menor o igual, o mayor
   130                                  ; Entrada: AX y BX con valores 0-9
   131                                  ; Reutiliza las macros print_str, print_digito y nueva_linea de macros.asm. A
   132                                  ; diferencia de comparar_e_imprimir (que decide con JE/JG), aqui la decision se
   133                                  ; toma con un unico salto condicional, JLE. Preserva AX y BX con PUSH/POP.
   134                                  comparar_menor_o_igual:
   135 000000D6 50                          push ax
   136 000000D7 53                          push bx
   137 000000D8 39D8                        cmp ax, bx                  ; actualiza flags con AX - BX
   138 000000DA 7E19                        jle .menor_o_igual          ; AX <= BX con signo (ZF = 1 o SF != OF)
   139                                  
   140                                      ; Caso: AX es mayor
   141 000000DC 88C3                        mov bl, al                  ; BL = copia del valor de AX (AL cambia al imprimir)
   142                                      print_str msg_mayor2
    31 000000DE B409                <1>  mov ah, 09h
    32 000000E0 BA[D200]            <1>  mov dx, %1
    33 000000E3 CD21                <1>  int 21h
   143 000000E5 88D8                        mov al, bl                  ; AL = valor de AX
   144                                      print_digito
    74 000000E7 50                  <1>  push ax
    75 000000E8 240F                <1>  and al, 0Fh
    76 000000EA 0430                <1>  add al, 30h
    77 000000EC B402                <1>  mov ah, 02h
    78 000000EE 88C2                <1>  mov dl, al
    79 000000F0 CD21                <1>  int 21h
    80 000000F2 58                  <1>  pop ax
   145 000000F3 EB17                        jmp .fin_cmp2
   146                                  
   147                                  .menor_o_igual:
   148 000000F5 88C3                        mov bl, al                  ; BL = copia del valor de AX
   149                                      print_str msg_menor_igual
